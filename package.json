{
  "name": "atsha-server",
  "version": "1.0.0",
  "description": "Backend server for atsha Restaurant Management System",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"__tests__/**/*.test.js\"",
    "sync:document-contract": "node scripts/syncDocumentContract.js",
    "check:document-contract": "node scripts/syncDocumentContract.js --check",
    "seed:test-data": "node scripts/seed.js",
    "migrate:default-org": "node scripts/backfillDefaultOrganization.js",
    "migrate:default-org:dry": "node scripts/backfillDefaultOrganization.js --dry-run",
    "migrate:layout-v2": "node scripts/migrateTemplatesToLayoutV2.js",
    "migrate:layout-v2:dry": "node scripts/migrateTemplatesToLayoutV2.js --dry-run",
    "migrate:layout-v2:rollback": "node scripts/migrateTemplatesToLayoutV2.js --rollback"
  },
  "keywords": [
    "restaurant",
    "management",
    "forms",
    "attendance"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.11",
    "pdfkit": "^0.14.0",
    "qrcode": "^1.5.3",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
